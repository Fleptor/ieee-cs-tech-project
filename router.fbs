// router.fbs
// Compile with: flatc --rust router.fbs

enum DeviceState: byte { Allowed = 0, Blocked = 1, Suspicious = 2 }

table RegisterRequest {
    network_id: string;
    mac: string;
    hostname: string;
    ip: string;
    manufacturer: string;
}

table ChangeStateRequest {
    network_id: string;
    mac: string;
    state: string;
}

// --- NEW: THE AI TELEMETRY PAYLOAD ---
table TelemetryReport {
    network_id: string;
    mac: string;                     // Matches the 6-byte internal_mac from the ring buffer
    
    // Feature A: Exfiltration 
    // Rust Aggregator sums payload_len where (flags & F_WAN_IN) vs (flags & F_WAN_OUT)
    bytes_in: ulong;                 
    bytes_out: ulong;                
    
    // Feature B: IP Velocity
    // Rust Aggregator counts unique external_ip occurrences
    unique_internal_ips: uint;       
    unique_external_ips: uint;       
    
    // Feature C: Kernel Threat Diagnostics
    // Replaces raw TCP flags. The Rust Aggregator tallies your custom 7-bit eBPF verdicts
    total_connections: uint;         
    passed_connections: uint;        // Tally of packets where (flags & 1) 
    dropped_connections: uint;       // Tally of packets dropped (Legacy Hard Drops)
    anomaly_flags_count: uint;       // Tally of (flags & 8) - DPI failures
    heuristic_flags_count: uint;     // Tally of (flags & 32) - mDNS/SSDP anomalies
    infra_alert_count: uint;         // Tally of (flags & 64) - Rogue DHCP/ARP
    
    // Feature D: Port Entropy
    // Calculated based on spread of the 2-byte dst_port
    port_entropy_score: float;       
}

// Update the Envelope to include the TelemetryReport
union IncomingPayload {
    RegisterRequest,
    ChangeStateRequest,
    TelemetryReport
}

table RouterMessage {
    payload: IncomingPayload;
}

// Cloud -> Router Command
table RouterResponse {
    status: string;
    mac: string;
}

root_type RouterMessage;