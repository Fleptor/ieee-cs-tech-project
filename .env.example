# scripts/init-local.sh generates unique secrets in .local/cipher.env.
JWT_SECRET=replace-with-a-long-random-secret
ROUTER_SECRET=replace-with-a-different-long-random-secret
CIPHER_NETWORK_ID=NET_123
CIPHER_INTERFACE=enp7s0
CIPHER_BIND=127.0.0.1:3000
CIPHER_SERVER_URL=wss://localhost:3000
# Response policy defaults to observe and is managed in Engine health.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Anthropic: https://api.anthropic.com/v1
# OpenAI or compatible: https://api.openai.com/v1 (or your provider's /v1 URL)
# LLM_BASE_URL=https://api.anthropic.com/v1
LLM_TIMEOUT_SECONDS=20
# Compatible servers may require max_tokens instead.
LLM_TOKEN_PARAMETER=max_completion_tokens
CIPHER_ALERT_COOLDOWN_SECONDS=120
